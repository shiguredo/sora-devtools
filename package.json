  "author": "Shiguredo Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiguredo/sora-devtools.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 3333",
    "build": "vp build",
    "preview": "vp preview",
    "fmt": "vp fmt",
    "lint": "vp lint --type-aware",
    "lint:fix": "vp lint --type-aware --fix",
    "test": "vp test run",
    "test:ct": "vp test run --config vitest.ct.config.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --project=chromium",
    "cleanup": "git clean -ffdx --exclude .env"
  },
  "dependencies": {
    "@preact/signals": "2.9.0",
    "preact": "10.29.0",
    "sora-js-sdk": "2025.2.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.3.0",
    "@playwright/test": "1.58.2",
    "@preact/preset-vite": "2.10.5",
    "@preact/signals-agent-vite": "0.1.0",
    "@shiguredo/mp4-media-stream": "2024.3.0",
    "@shiguredo/noise-suppression": "2025.1.0",
    "@shiguredo/virtual-background": "2023.2.0",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "25.5.0",
    "@vitest/browser": "4.1.2",
    "@vitest/browser-playwright": "4.1.2",
    "@vitest/browser-preview": "4.1.2",
    "dotenv": "17.3.1",
    "fast-check": "4.6.0",
    "jsdom": "29.0.1",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.14",
    "vite-plus": "0.1.14",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.14",
    "vitest-browser-preact": "1.0.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0"
}
