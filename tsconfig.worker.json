{
  // Web Worker の型チェック設定
  // 共通設定は tsconfig.json から継承し、必要になる lib / types と include / exclude を worker 向けに指定し直す
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // コンパイルに含める標準ライブラリの型定義を指定する
    // webworker を指定することで self が WorkerGlobalScope として解決され、
    // globalThis も worker のグローバルを集めた型になる
    // webworker.iterable は TypeScript 7 では空のファイルで効果を持たないため指定しない
    "lib": ["webworker", "esnext"],
    // グローバルに取り込む型定義の指定を共通設定の値ごと上書きする
    // 共通設定の vite-plus/test/globals を継承すると worker にテスト用のグローバルが入るため、
    // worker にはテスト用のグローバルを取り込まない
    "types": []
    // 共通設定の paths は @/* を src/ 全体に解決するため、worker から @/ を使わない
    // worker から app 側のファイルを引くと dom に依存した型エラーが worker の型チェックで発生する
    // worker で型を共有するときは、実装を含まない共通ファイルを相対 import で参照する
  },
  // コンパイル対象から除外するパスを指定する
  "exclude": ["node_modules"],
  // コンパイル対象に含めるパスを指定する
  // global.d.ts の Window 拡張と AudioContext / Element は webworker の型定義に無いため worker では含めない
  "include": ["src/workers/**/*.ts"]
}
